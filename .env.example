# Copy to .env and fill in. Never commit .env.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=pws_alpha_dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Demo/dev only: seeds accounts with published passwords (Super@123 etc).
# MUST stay unset in production.
SEED_DEMO_DATA=

# Production bootstrap: creates one super admin on an empty DB, forced to
# change password at first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Comma-separated frontend origins. Unset falls back to "*" (dev only).
CORS_ALLOWED_ORIGINS=
